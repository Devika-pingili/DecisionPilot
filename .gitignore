# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments and local environment files
.venv/
venv/
env/
.env
.env.*

# VS Code local settings
.vscode/

# Raw and generated datasets
# The Instacart source data must remain outside Git.
data/raw/
data/processed/

# The bounded demo CSVs and saved model are intentionally commit-eligible.
# Its generated SQLite index is rebuilt from those CSVs on a fresh deployment.
data/demo/processed/history.sqlite
data/demo/processed/history.sqlite-journal
data/demo/processed/history.sqlite-wal
data/demo/processed/history.sqlite-shm

# Local logs and temporary files
*.log
*.tmp
